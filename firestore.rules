rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isArtesano() {
      // 'admin' tiene los mismos privilegios de contenido que 'artesano'.
      return getUserRole() == 'artesano' || getUserRole() == 'admin';
    }

    function isCourseOwner(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.createdBy == request.auth.uid;
    }

    function isCoursePublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.published == true;
    }

    // ── allowedUsers ──────────────────────────────────────────────────────────

    match /allowedUsers/{email} {
      // Cada usuario solo puede leer su propio doc (uid coincide con email en esta app).
      // Los artesanos pueden leer todos (panel de admin / dashboards).
      allow read: if isAuthenticated() && (request.auth.uid == email || isArtesano());
      // Solo se escribe desde el Admin SDK / Firebase Console — nunca desde el cliente
      allow write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Cualquier usuario autenticado puede leer su propio documento
      allow read: if isAuthenticated() && isOwner(userId);

      // Creación: solo el propio usuario (primer login via auth-context)
      allow create: if isAuthenticated() && isOwner(userId);

      // Actualización: el usuario puede editar su propio doc PERO NO puede
      // cambiar el campo `role` — ese campo solo lo modifica un admin manualmente
      allow update: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.role == resource.data.role;
    }

    // ── Courses ───────────────────────────────────────────────────────────────

    match /courses/{courseId} {
      // Cualquier usuario autenticado puede leer cursos (participantes ven publicados).
      allow read: if isAuthenticated();
      // Artesanos: pueden crear, modificar y archivar cualquier curso.
      allow create, delete: if isAuthenticated() && isArtesano();
      allow update: if isAuthenticated() && (
        isArtesano() ||
        // Participantes pueden actualizar solo los contadores agregados
        // (enrolledCount via enrollParticipant, completedCount via awardCredit).
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['enrolledCount', 'completedCount'])
      );

      match /chapters/{chapterId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && isArtesano();

        match /resources/{resourceId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && isArtesano();
        }
      }
    }

    // ── AuditLog ──────────────────────────────────────────────────────────────

    match /auditLog/{logId} {
      // Solo el admin puede leer (verificación por UID)
      allow read: if isAuthenticated() && request.auth.uid == 'danilo.sosa@texo.com.py';
      // Cualquier usuario autenticado puede CREAR (silentAudit desde cliente),
      // pero nadie puede modificar o borrar entradas — solo Admin SDK / consola.
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ── LoginHistory ──────────────────────────────────────────────────────────

    match /loginHistory/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == 'danilo.sosa@texo.com.py';
      allow write: if isAuthenticated() && isOwner(userId);

      match /sessions/{sessionId} {
        allow read: if isAuthenticated() && request.auth.uid == 'danilo.sosa@texo.com.py';
        allow write: if isAuthenticated() && isOwner(userId);
      }
    }

    // ── Progress ──────────────────────────────────────────────────────────────

    match /progress/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);

      match /courses/{courseId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && isOwner(userId);

        match /resources/{resourceId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && isOwner(userId);
        }
      }
    }
  }
}
